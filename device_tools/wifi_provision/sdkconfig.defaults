# Applied on top of the firmware's ../../sdkconfig.defaults (see the Makefile),
# which is the single source of truth for the target, console, flash size and
# encrypted-NVS scheme. Only the path to the shared partition table differs, as
# it is resolved relative to this project directory.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions.csv"
